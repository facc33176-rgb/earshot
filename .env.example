# ---------- Earshot settings ----------
# Copy this file to .env and fill it in. Lines starting with # are ignored.

# Port the server listens on. Open http://localhost:8787 on this computer.
PORT=8787

# Optional password. If set, the call page asks for it once and remembers it.
# Strongly recommended if the server is reachable from the internet: every call spends your API credit.
ACCESS_TOKEN=

# ---- The brain: any OpenAI-compatible chat API (OpenAI, OpenRouter, DeepSeek, a local Ollama, ...) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional second model. If the first one has not said a word after HEDGE_MS, this one is asked too
# and whichever speaks first wins. Leave empty to turn this off.
LLM_BACKUP_MODEL=
HEDGE_MS=6000

# ---- The ears: speech-to-text (used on iPhone and anywhere the browser cannot transcribe by itself) ----
# Any OpenAI-compatible /audio/transcriptions endpoint: OpenAI whisper-1, Groq whisper-large-v3-turbo, a local faster-whisper server...
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Language hint for the transcriber, e.g. en, zh. Empty = auto-detect.
STT_LANGUAGE=

# ---- The voice ----
# elevenlabs (most expressive, supports [laughs] style tags) or openai (any OpenAI-compatible /audio/speech)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 understands audio tags like [chuckles] [sighs]; eleven_flash_v2_5 is faster but plainer.
ELEVENLABS_MODEL=eleven_v3
# Most ElevenLabs plans allow only a few generations at once. Extra sentences wait in line.
TTS_CONCURRENCY=2

OPENAI_TTS_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---- Character ----
# File describing who the AI is. Copy persona.example.md to persona.md and make it yours.
PERSONA_FILE=persona.md
# Name shown on the call screen.
CALLER_NAME=Earshot
# Reply language: en or zh
REPLY_LANG=en
